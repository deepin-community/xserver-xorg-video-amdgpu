diff --git a/src/drmmode_display.c b/src/drmmode_display.c
index 5b73fce..b93c01f 100644
--- a/src/drmmode_display.c
+++ b/src/drmmode_display.c
@@ -30,6 +30,7 @@
 #endif
 
 #include <errno.h>
+#include <strings.h>
 #include <sys/ioctl.h>
 #include <time.h>
 #include "cursorstr.h"
@@ -1240,6 +1241,114 @@ drmmode_crtc_gamma_do_set(xf86CrtcPtr crtc, uint16_t *red, uint16_t *green,
 			   ret);
 }
 
+/*
+ * Built-in quirk table for transparent clock reduction.
+ *
+ * For certain GPU + monitor + pixel-clock combinations the hardware does
+ * not accept the EDID clock exactly and the display goes black.  The quirk
+ * below reduces kmode.clock by a small amount at modeset time only when a
+ * targeted monitor (identified by EDID vendor + product id) runs at one of
+ * the listed clocks.  Every other display is left untouched.  xrandr still
+ * reports the original EDID clock.
+ *
+ * Controlled by xorg.conf Option "ClockReduction" (default on).
+ */
+
+typedef struct {
+	int gpu_id;
+	const char *vendor;
+	int prod_id;
+	int clock_khz;
+	int amount_khz;
+} clock_reduction_entry_t;
+
+static const clock_reduction_entry_t clock_reduction_quirks[] = {
+	/* gpu_id,  vendor,  prod_id,  clock_khz,  amount_khz */
+	{ 0x6611, "XMI", 0x23c3, 185590, 100 },
+};
+
+static Bool clock_reduction_lookup(const clock_reduction_entry_t *table,
+				   int table_size, int device_id,
+				   const char *vendor, int prod_id,
+				   int clock, int *amount)
+{
+	int i;
+
+	for (i = 0; i < table_size; i++) {
+		if (table[i].gpu_id == device_id &&
+		    table[i].prod_id == prod_id &&
+		    table[i].clock_khz == clock &&
+		    strcasecmp(table[i].vendor, vendor) == 0) {
+			*amount = table[i].amount_khz;
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+
+static void apply_clock_reduction_kmode(ScrnInfoPtr scrn,
+					AMDGPUInfoPtr info,
+					xf86CrtcPtr crtc,
+					drmModeModeInfo *kmode,
+					int original_clock)
+{
+	xf86CrtcConfigPtr xf86_config = XF86_CRTC_CONFIG_PTR(scrn);
+	int amount = 0, new_clock;
+	const char *vendor = NULL;
+	int prod_id = 0;
+	int i;
+
+	if (!scrn || !info || !kmode || !crtc)
+		return;
+	if (!info->clock_reduction_enabled)
+		return;
+
+	/* The reduced clock is shared by every output driven by this CRTC,
+	 * so only reduce when every EDID-bearing output bound to the CRTC
+	 * is the same targeted monitor.  A CRTC driving two different
+	 * monitors (clone) is left untouched so the quirk can never hurt a
+	 * display that does not need it.
+	 */
+	for (i = 0; i < xf86_config->num_output; i++) {
+		xf86OutputPtr output = xf86_config->output[i];
+		xf86MonPtr mon;
+
+		if (output->crtc != crtc)
+			continue;
+
+		mon = output->MonInfo;
+		if (!mon)
+			return;
+
+		if (!vendor) {
+			vendor = mon->vendor.name;
+			prod_id = mon->vendor.prod_id;
+		} else if (strcasecmp(vendor, mon->vendor.name) != 0 ||
+			   prod_id != mon->vendor.prod_id) {
+			/* Distinct monitors share this CRTC: do nothing. */
+			return;
+		}
+	}
+
+	if (!vendor)
+		return;
+
+	if (!clock_reduction_lookup(clock_reduction_quirks,
+				    sizeof(clock_reduction_quirks) /
+				    sizeof(clock_reduction_quirks[0]),
+				    info->device_id, vendor, prod_id,
+				    original_clock, &amount))
+		return;
+
+	new_clock = original_clock - amount;
+
+	kmode->clock = new_clock;
+	xf86DrvMsgVerb(scrn->scrnIndex, X_INFO, AMDGPU_LOGLEVEL_DEBUG,
+		"ClockReduction: Reduced clock %d -> %d kHz (gpu=0x%x, vendor=%s, prod=0x%x, amount=%d)\n",
+		original_clock, new_clock, info->device_id, vendor, prod_id,
+		amount);
+}
+
 Bool
 drmmode_set_mode(xf86CrtcPtr crtc, struct drmmode_fb *fb, DisplayModePtr mode,
 		 int x, int y)
@@ -1270,6 +1379,9 @@ drmmode_set_mode(xf86CrtcPtr crtc, struct drmmode_fb *fb, DisplayModePtr mode,
 
 	drmmode_ConvertToKMode(scrn, &kmode, mode);
 
+	apply_clock_reduction_kmode(scrn, AMDGPUPTR(scrn), crtc, &kmode,
+				    mode->Clock);
+
 	ret = drmModeSetCrtc(pAMDGPUEnt->fd,
 			     drmmode_crtc->mode_crtc->crtc_id,
 			     fb->handle, x, y, output_ids,
